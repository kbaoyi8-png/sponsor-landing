<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Spensor — AI Agent for Field Marketing</title>
  <meta name="description" content="Spensor parses your exhibitor toolkits, drafts the runbook, and tracks every deadline so your team stops rebuilding from scratch." />

  <!-- Open Graph -->
  <meta property="og:title" content="Spensor — The AI teammate for field marketing" />
  <meta property="og:description" content="Parses toolkits. Drafts runbooks. Hits deadlines. Spensor runs the work behind every event." />
  <meta property="og:image" content="https://spensor.co/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://spensor.co/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Spensor" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Spensor — The AI teammate for field marketing" />
  <meta name="twitter:description" content="Parses toolkits. Drafts runbooks. Hits deadlines. Spensor runs the work behind every event." />
  <meta name="twitter:image" content="https://spensor.co/og-image.png" />

  <template id="__bundler_thumbnail" data-bg-color="#0A0A0A">
    <svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
      <rect width="1200" height="800" fill="#0A0A0A"/>
      <text x="120" y="380" font-family="sans-serif" font-size="96" font-weight="300" fill="#F2F0EB" letter-spacing="-2">Spensor</text>
      <rect x="120" y="400" width="180" height="3" fill="#4338CA"/>
      <text x="120" y="450" font-family="monospace" font-size="22" fill="#8A8882" letter-spacing="4">FIELD MARKETING INTELLIGENCE</text>
    </svg>
  </template>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- React + Babel for Tweaks panel -->
  <script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background-color: #0A0A0A;
      color: #F2F0EB;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      position: relative;
    }

    /* ── Noise texture ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml;base64,");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* ── Layout helpers ── */
    .container { max-width: 1152px; margin: 0 auto; width: 100%; }
    .row { display: flex; align-items: center; }
    .row-between { display: flex; align-items: center; justify-content: space-between; }
    .col { display: flex; flex-direction: column; }
    .section-inner { padding: 7rem 3rem; }
    .section-border { border-top: 1px solid #1E1E1E; }

    /* ────────────────────────────────
       METRICS / DATA SECTION
    ──────────────────────────────── */
    #metrics .inner {
      max-width: 1152px;
      margin: 0 auto;
      padding: 7rem 3rem;
    }
    #metrics .metrics-head {
      max-width: 720px;
      margin-bottom: 4rem;
    }
    #metrics h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-top: 1rem;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .metric-card {
      background: #111111;
      border: 1px solid #1E1E1E;
      border-radius: 2px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      min-height: 240px;
      transition: border-color 240ms;
    }
    .metric-card:hover { border-color: #4338CA; }
    .metric-card .metric-label {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #8A8882;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .metric-card .metric-label::before {
      content: '';
      width: 6px; height: 6px; border-radius: 50%;
      background: #4338CA;
      box-shadow: 0 0 8px rgba(67,56,202,0.7);
      animation: live-pulse 1.6s ease-in-out infinite;
    }
    @keyframes live-pulse {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }
    .metric-card .metric-value {
      font-size: 2.6rem;
      font-weight: 300;
      letter-spacing: -0.03em;
      color: #F2F0EB;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .metric-card .metric-sub {
      font-size: 0.78rem;
      color: #8A8882;
      font-weight: 400;
      line-height: 1.5;
    }
    .metric-card .metric-viz {
      flex: 1;
      display: flex;
      align-items: flex-end;
      min-height: 64px;
    }

    /* Bar viz */
    .bar-viz {
      display: flex;
      align-items: flex-end;
      gap: 4px;
      width: 100%;
      height: 64px;
    }
    .bar-viz .bar {
      flex: 1;
      height: 100%;
      background: #1E1E1E;
      border-radius: 1px;
      transform-origin: bottom;
      transform: scaleY(0);
      transition: transform 700ms cubic-bezier(0.4, 0, 0.2, 1), background-color 400ms;
    }
    .metric-card.in-view .bar-viz .bar { transform: scaleY(var(--h, 0.3)); }
    .metric-card.in-view .bar-viz .bar.accent { background: #4338CA; box-shadow: 0 0 12px rgba(67,56,202,0.4); }
    .metric-card.in-view .bar-viz .bar.latest {
      animation: bar-breathe 2.4s ease-in-out infinite;
      animation-delay: 1.4s;
    }
    @keyframes bar-breathe {
      0%, 100% { transform: scaleY(var(--h, 0.3)); box-shadow: 0 0 12px rgba(67,56,202,0.4); }
      50% { transform: scaleY(calc(var(--h, 0.3) * 1.04)); box-shadow: 0 0 22px rgba(67,56,202,0.7); }
    }

    /* Deadline grid viz */
    .deadline-grid {
      display: grid;
      grid-template-columns: repeat(14, 1fr);
      gap: 4px;
      width: 100%;
    }
    .deadline-grid .cell {
      aspect-ratio: 1;
      background: #1E1E1E;
      border-radius: 1px;
      transition: background-color 400ms ease;
    }
    .metric-card.in-view .deadline-grid .cell.done { background: #4338CA; }
    .metric-card.in-view .deadline-grid .cell.warn { background: #2A2A40; }
    .metric-card.in-view .deadline-grid .cell.miss { background: #4A1F1F; }

    /* Stream viz */
    .stream-viz {
      width: 100%;
      height: 64px;
      position: relative;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    }
    .stream-viz .stream-line {
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: 1px;
      background: #1E1E1E;
    }
    .stream-viz .pkt {
      position: absolute;
      top: 50%;
      width: 28px;
      height: 18px;
      transform: translateY(-50%);
      border: 1px solid #4338CA;
      background: rgba(67,56,202,0.12);
      border-radius: 1px;
      animation: pkt-flow 4.5s linear infinite;
    }
    .stream-viz .pkt::before {
      content: 'PDF';
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Roboto Mono', monospace;
      font-size: 0.55rem;
      color: #818CF8;
      letter-spacing: 0.05em;
    }
    .stream-viz .pkt.doc::before { content: 'DOC'; }
    .stream-viz .pkt.eml::before { content: 'EML'; }
    @keyframes pkt-flow {
      0% { left: -10%; opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { left: 110%; opacity: 0; }
    }

    @media (max-width: 768px) {
      .metrics-grid { grid-template-columns: 1fr; }
      #metrics .inner { padding: 4rem 1.5rem; }
    }

    /* ── Typography ── */
    .mono { font-family: 'Roboto Mono', monospace; }
    .label { font-family: 'Roboto Mono', monospace; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: #8A8882; }
    .label-accent { color: #4338CA; }
    .text-dim { color: #8A8882; }
    .text-light { color: #F2F0EB; }

    /* ── Teal rule accent ── */
    .teal-rule::before {
      content: '';
      display: block;
      width: 32px;
      height: 2px;
      background: #4338CA;
      margin-bottom: 1.5rem;
    }

    /* ── Gradient heading ── */
    .gradient-text {
      background: linear-gradient(135deg, #F2F0EB 40%, #4338CA 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Buttons ── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      background-color: #4338CA;
      color: #F2F0EB;
      font-family: 'Roboto Mono', monospace;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      white-space: nowrap;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 180ms ease, box-shadow 180ms ease;
    }
    .btn-primary:hover {
      background-color: #4F46E5;
      box-shadow: 0 0 22px 0 rgba(67,56,202,0.45);
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.7rem 1.5rem;
      background-color: transparent;
      color: #F2F0EB;
      font-family: 'Roboto Mono', monospace;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      border: 1px solid #1E1E1E;
      border-radius: 2px;
      cursor: pointer;
      text-decoration: none;
      transition: border-color 180ms ease, color 180ms ease;
    }
    .btn-secondary:hover {
      border-color: #4338CA;
      color: #6366F1;
    }

    /* ── Step cards ── */
    .step-card {
      background: #111111;
      border: 1px solid #1E1E1E;
      border-radius: 2px;
      padding: 2rem;
      transition: border-color 240ms ease;
    }
    .step-card:hover { border-color: #4338CA; }
    .step-card-footer {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #1E1E1E;
    }

    /* ── Scroll reveal ── */
    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.55s ease, transform 0.55s ease;
    }
    .reveal.visible { opacity: 1; transform: none; }

    /* ────────────────────────────────
       NAV
    ──────────────────────────────── */
    #nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      padding: 1.25rem 3rem;
      border-bottom: 1px solid transparent;
      transition: border-color 300ms, background-color 300ms;
    }
    #nav.scrolled {
      border-color: #1E1E1E;
      background-color: var(--nav-bg, rgba(10,10,10,0.88));
      backdrop-filter: blur(12px);
    }
    #nav .nav-inner {
      max-width: 1152px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #F2F0EB;
    }
    #nav .btn-primary {
      padding: 0.5rem 1rem;
      font-size: 0.72rem;
    }

    /* ────────────────────────────────
       HERO
    ──────────────────────────────── */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10rem 5rem 8rem;
    }
    #hero .glow {
      position: absolute;
      width: 700px; height: 500px;
      background: radial-gradient(circle, rgba(67,56,202,0.10) 0%, transparent 70%);
      top: 10%; left: 40%;
      transform: translateX(-50%);
      filter: blur(90px);
      pointer-events: none;
    }
    #hero .hero-inner {
      position: relative;
      max-width: 1152px;
      margin: 0 auto;
      width: 100%;
    }
    #hero .eyebrow { margin-bottom: 5rem; }
    #hero .meet {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
      color: #F2F0EB;
      margin-bottom: 1.5rem;
    }
    #hero .meet::after {
      content: '';
      display: block;
      width: 48px;
      height: 3px;
      background: #4338CA;
      margin-top: 1.25rem;
    }
    #hero h1 {
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      font-weight: 300;
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin-bottom: 1.75rem;
      max-width: 760px;
      color: #C8C6C0;
    }
    #hero h1 .gradient-text { font-weight: 500; }
    #hero .subhead {
      font-size: 1rem;
      color: #C8C6C0;
      font-weight: 400;
      line-height: 1.6;
      max-width: 560px;
      margin-bottom: 2rem;
      letter-spacing: 0.01em;
    }
    #hero .cta-row {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }
    #hero .status {
      opacity: 0.5;
    }


    /* ────────────────────────────────
       PROOF / FLOW
    ──────────────────────────────── */
    #proof {
      border-top: 1px solid #1E1E1E;
    }
    #proof .inner {
      max-width: 1152px;
      margin: 0 auto;
      padding: 5rem 3rem;
    }
    #proof .proof-label {
      text-align: center;
      margin-bottom: 3.5rem;
    }
    .flow-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 0;
    }
    .flow-node {
      background: #111111;
      border: 1px solid #1E1E1E;
      border-radius: 2px;
      padding: 1.5rem;
      text-align: center;
      transition: border-color 240ms;
    }
    .flow-node:hover { border-color: #4338CA; }
    .flow-node .flow-icon {
      width: 20px;
      height: 20px;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.8;
    }
    .flow-node .flow-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: #F2F0EB;
      margin-bottom: 0.35rem;
    }
    .flow-node .flow-desc {
      font-size: 0.7rem;
      color: #8A8882;
      font-weight: 300;
      line-height: 1.5;
    }
    .flow-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 0.5rem;
      color: #1E1E1E;
    }
    .flow-arrow svg { display: block; }
    .flow-node.flow-node--accent {
      border-color: #4338CA;
      background: #0D0D1A;
    }
    .flow-node.flow-node--accent .flow-title { color: #818CF8; }
    @media (max-width: 768px) {
      .flow-row {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .flow-arrow { transform: rotate(90deg); padding: 0.25rem 0; }
      #proof .inner { padding: 3rem 1.5rem; }
    }

    /* ────────────────────────────────
       PROBLEM
    ──────────────────────────────── */
    #problem .inner {
      max-width: 1152px;
      margin: 0 auto;
      padding: 7rem 3rem;
    }
    #problem .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
      margin-top: 1rem;
    }
    #problem h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    #problem p {
      color: #8A8882;
      font-size: 1.125rem;
      font-weight: 300;
      line-height: 1.625;
    }
    #problem p + p { margin-top: 1.5rem; }

    /* ────────────────────────────────
       HOW IT WORKS
    ──────────────────────────────── */
    #how .inner {
      max-width: 1152px;
      margin: 0 auto;
      padding: 7rem 3rem;
    }
    #how h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
      max-width: none;
      white-space: nowrap;
      text-align: left;
      margin-bottom: 4rem;
      margin-top: 1rem;
    }
    @media (max-width: 1100px) {
      #how h2 { white-space: normal; max-width: 720px; }
    }
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .step-num {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.72rem;
      color: #4338CA;
      letter-spacing: 0.15em;
      margin-bottom: 1.5rem;
    }
    .step-card h3 {
      font-size: 1.15rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 1rem;
    }
    .step-card p {
      color: #8A8882;
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.625;
    }

    /* ────────────────────────────────
       CTA
    ──────────────────────────────── */
    #cta {
      position: relative;
      overflow: hidden;
      border-top: 1px solid #1E1E1E;
    }
    #cta .glow {
      position: absolute;
      width: 600px; height: 400px;
      background: radial-gradient(ellipse, rgba(67,56,202,0.15) 0%, transparent 70%);
      bottom: -100px; right: -100px;
      filter: blur(80px);
      pointer-events: none;
    }
    #cta .inner {
      position: relative;
      max-width: 1152px;
      margin: 0 auto;
      padding: 7rem 3rem;
    }
    #cta .cta-content { max-width: 680px; }
    #cta h2 {
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-top: 1rem;
      margin-bottom: 1.5rem;
    }
    #cta .cta-sub {
      color: #8A8882;
      font-size: 1.125rem;
      font-weight: 300;
      line-height: 1.625;
      max-width: 560px;
      margin-bottom: 2.5rem;
    }
    #cta .cta-btns {
      display: flex;
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    #cta .trust {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    #cta .access-form {
      margin-top: 0.5rem;
      max-width: 560px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    #cta .access-form .full { grid-column: 1 / -1; }
    #cta .access-form label {
      display: block;
      font-family: 'Roboto Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #8A8882;
      margin-bottom: 0.5rem;
    }
    #cta .access-form input,
    #cta .access-form textarea,
    #cta .access-form select {
      width: 100%;
      background: #111111;
      border: 1px solid #1E1E1E;
      border-radius: 2px;
      padding: 0.75rem 0.9rem;
      color: #F2F0EB;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      font-weight: 400;
      transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
      -webkit-appearance: none;
      appearance: none;
    }
    #cta .access-form textarea {
      resize: vertical;
      min-height: 96px;
      font-family: 'Inter', sans-serif;
    }
    #cta .access-form input::placeholder,
    #cta .access-form textarea::placeholder {
      color: #5A5853;
    }
    #cta .access-form input:focus,
    #cta .access-form textarea:focus,
    #cta .access-form select:focus {
      outline: none;
      border-color: #4338CA;
      box-shadow: 0 0 0 3px rgba(67,56,202,0.18);
      background-color: #131322;
    }
    #cta .access-form select {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%238A8882' stroke-width='1.2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
      background-repeat: no-repeat;
      background-position: right 0.9rem center;
      padding-right: 2rem;
    }
    #cta .access-form .form-actions {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }
    #cta .access-form button[type="submit"] {
      cursor: pointer;
      border: none;
    }
    #cta .access-form button[disabled] { opacity: 0.6; cursor: progress; }
    #cta .form-status {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.72rem;
      color: #8A8882;
    }
    #cta .form-status.success { color: #818CF8; }
    #cta .form-status.error { color: #F87171; }
    #cta .access-form-success {
      grid-column: 1 / -1;
      padding: 1.25rem 1.5rem;
      border: 1px solid #4338CA;
      background: #0D0D1A;
      border-radius: 2px;
      color: #F2F0EB;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    @media (max-width: 600px) {
      #cta .access-form { grid-template-columns: 1fr; }
    }

    /* ────────────────────────────────
       FOOTER
    ──────────────────────────────── */
    footer {
      border-top: 1px solid #1E1E1E;
      padding: 2.5rem 3rem;
    }
    footer .inner {
      max-width: 1152px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }
    footer .right {
      display: flex;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    footer a {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.72rem;
      color: #8A8882;
      text-decoration: none;
      transition: color 150ms;
    }
    footer a:hover { color: #4338CA; }

    /* ────────────────────────────────
       RESPONSIVE
    ──────────────────────────────── */
    @media (max-width: 768px) {
      #nav { padding: 1.25rem 1.5rem; }
      #hero { padding: 7rem 1.5rem 4rem; }
      #problem .inner,
      #how .inner,
      #cta .inner { padding: 4rem 1.5rem; }
      footer { padding: 2rem 1.5rem; }
      #problem .grid { grid-template-columns: 1fr; gap: 2rem; }
      .steps-grid { grid-template-columns: 1fr; gap: 1rem; }
      #hero .cta-row { flex-direction: column; }
      footer .inner { flex-direction: column; align-items: flex-start; }
      footer .right { gap: 1rem; }
    }
  </style>
</head>

<body>

  <!-- ── NAV ── -->
  <nav id="nav">
    <div class="nav-inner">
      <span class="nav-logo">Spensor AI</span>
      <a href="#cta" class="btn-primary">Reserve a spot →</a>
    </div>
  </nav>


  <!-- ── HERO ── -->
  <section id="hero">
    <canvas id="hero-canvas" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:0.75;"></canvas>
    <div class="glow"></div>
    <div class="hero-inner" style="position:relative;z-index:1;">

      <div class="reveal eyebrow">
        <span class="label">Field Marketing Intelligence</span>
      </div>

      <div class="reveal" style="margin-bottom: 0;">
        <span class="meet">Meet Spensor.</span>
      </div>

      <h1 class="reveal">
        <span class="gradient-text" style="font-weight:600;">The AI teammate for field marketing.</span>
      </h1>

      <p class="reveal subhead">
        Reads your exhibitor toolkits, extracts the tasks, drafts the work. You approve, Spensor delivers. Never miss a deadline again.
      </p>

      <div class="reveal cta-row">
        <a href="#cta" class="btn-primary">Reserve a spot</a>
      </div>

      <div class="reveal status">
        <span class="mono" style="font-size:0.72rem; color:#8A8882;">Now onboarding 20 design partners.</span>
      </div>

    </div>
  </section>



  <!-- ── PROOF / FLOW ── -->
  <section id="proof">
    <div class="inner">
      <div class="reveal proof-label">
        <span class="label">How a typical event flows through Spensor</span>
      </div>
      <div class="flow-row reveal">
        <div class="flow-node">
          <span class="flow-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="2" width="12" height="16" rx="1.5" stroke="#8A8882" stroke-width="1.25"/><line x1="7" y1="7" x2="13" y2="7" stroke="#8A8882" stroke-width="1.25" stroke-linecap="round"/><line x1="7" y1="10" x2="13" y2="10" stroke="#8A8882" stroke-width="1.25" stroke-linecap="round"/><line x1="7" y1="13" x2="11" y2="13" stroke="#8A8882" stroke-width="1.25" stroke-linecap="round"/></svg></span>
          <div class="flow-title">Event Brief</div>
          <div class="flow-desc">Upload your exhibitor toolkit or submit through an intake form.</div>
        </div>
        <div class="flow-arrow">
          <svg width="20" height="2" viewBox="0 0 20 2"><line x1="0" y1="1" x2="16" y2="1" stroke="#2A2A3A" stroke-width="1.5"/><path d="M14 0l4 1-4 1" fill="none" stroke="#2A2A3A" stroke-width="1.5"/></svg>
        </div>
        <div class="flow-node flow-node--accent">
          <span class="flow-icon" style="opacity:1;"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><polygon points="11,2 4,11 10,11 9,18 16,9 10,9" stroke="#818CF8" stroke-width="1.25" stroke-linejoin="round" fill="none"/></svg></span>
          <div class="flow-title">Spensor</div>
          <div class="flow-desc">Parses your input, drafts the runbook, assigns owners.</div>
        </div>
        <div class="flow-arrow">
          <svg width="20" height="2" viewBox="0 0 20 2"><line x1="0" y1="1" x2="16" y2="1" stroke="#2A2A3A" stroke-width="1.5"/><path d="M14 0l4 1-4 1" fill="none" stroke="#2A2A3A" stroke-width="1.5"/></svg>
        </div>
        <div class="flow-node">
          <span class="flow-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="14" height="13" rx="1.5" stroke="#8A8882" stroke-width="1.25"/><line x1="3" y1="8" x2="17" y2="8" stroke="#8A8882" stroke-width="1.25"/><line x1="7" y1="2" x2="7" y2="5" stroke="#8A8882" stroke-width="1.25" stroke-linecap="round"/><line x1="13" y1="2" x2="13" y2="5" stroke="#8A8882" stroke-width="1.25" stroke-linecap="round"/><circle cx="7" cy="12" r="1" fill="#8A8882"/><circle cx="10" cy="12" r="1" fill="#8A8882"/><circle cx="13" cy="12" r="1" fill="#8A8882"/></svg></span>
          <div class="flow-title">In Motion</div>
          <div class="flow-desc">Vendors briefed, deadlines tracked, blockers surfaced before they break.</div>
        </div>
        <div class="flow-arrow">
          <svg width="20" height="2" viewBox="0 0 20 2"><line x1="0" y1="1" x2="16" y2="1" stroke="#2A2A3A" stroke-width="1.5"/><path d="M14 0l4 1-4 1" fill="none" stroke="#2A2A3A" stroke-width="1.5"/></svg>
        </div>
        <div class="flow-node">
          <span class="flow-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="14" height="14" rx="1.5" stroke="#8A8882" stroke-width="1.25"/><line x1="7" y1="14" x2="7" y2="10" stroke="#8A8882" stroke-width="1.5" stroke-linecap="round"/><line x1="10" y1="14" x2="10" y2="7" stroke="#8A8882" stroke-width="1.5" stroke-linecap="round"/><line x1="13" y1="14" x2="13" y2="11" stroke="#8A8882" stroke-width="1.5" stroke-linecap="round"/></svg></span>
          <div class="flow-title">Closed Loop</div>
          <div class="flow-desc">Spend, attendance, and pipeline attribution — ready to share.</div>
        </div>
      </div>
      <div class="reveal" style="margin-top:2.5rem; text-align:center;">
        <span class="label" style="font-size:0.68rem; opacity:0.5;">No spreadsheets. No Slack threads. No rebuilding from scratch.</span>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ── -->
  <section id="problem" class="section-border">
    <div class="inner">

      <div class="reveal teal-rule">
        <span class="label label-accent">The Problem</span>
      </div>

      <div class="reveal grid">
        <h2>
          Field marketing runs on spreadsheets and Slack threads — not strategy.
        </h2>
        <div>
          <p>
            When you're running ten, twenty, or thirty events a year, the coordination cost is crushing. You're chasing vendors, reformatting briefs, updating trackers, syncing sales, and rebuilding the same runbooks from scratch — every single time.
          </p>
          <p>
            That's not a bandwidth problem. It's an infrastructure problem. Field marketing deserves the same operational leverage that engineering and finance take for granted. Spensor is that infrastructure.
          </p>
        </div>
      </div>

    </div>
  </section>


  <!-- ── METRICS / LIVE DATA ── -->
  <section id="metrics" class="section-border">
    <div class="inner">
      <div class="reveal teal-rule metrics-head">
        <span class="label label-accent">In production</span>
        <h2>What Spensor is doing right now.</h2>
      </div>

      <div class="metrics-grid">

        <!-- 1: Toolkit ingestion stream -->
        <div class="metric-card reveal" data-metric="ingest">
          <div class="metric-label">Toolkits ingested</div>
          <div class="metric-value" data-counter data-from="0" data-to="1247" data-suffix="">0</div>
          <div class="metric-sub">Exhibitor PDFs, vendor decks, and email threads parsed into structured tasks.</div>
          <div class="metric-viz">
            <div class="stream-viz">
              <div class="stream-line"></div>
              <div class="pkt" style="animation-delay: 0s;"></div>
              <div class="pkt doc" style="animation-delay: 0.9s;"></div>
              <div class="pkt eml" style="animation-delay: 1.8s;"></div>
              <div class="pkt" style="animation-delay: 2.7s;"></div>
              <div class="pkt doc" style="animation-delay: 3.6s;"></div>
            </div>
          </div>
        </div>

        <!-- 2: Deadlines hit -->
        <div class="metric-card reveal" data-metric="deadlines">
          <div class="metric-label">Deadlines hit</div>
          <div class="metric-value"><span data-counter data-from="0" data-to="98" data-suffix="">0</span><span style="font-size:1.4rem;color:#8A8882;">%</span></div>
          <div class="metric-sub">Out of 312 toolkit milestones across 24 events. Three flagged late, none missed.</div>
          <div class="metric-viz">
            <div class="deadline-grid" id="deadline-grid"></div>
          </div>
        </div>

        <!-- 3: Hours reclaimed -->
        <div class="metric-card reveal" data-metric="hours">
          <div class="metric-label">Hours reclaimed · per FTE / week</div>
          <div class="metric-value" data-counter data-from="0" data-to="14" data-suffix="h">0h</div>
          <div class="metric-sub">Time previously spent on toolkit triage, runbook drafting, and status pings.</div>
          <div class="metric-viz">
            <div class="bar-viz" id="hours-bars"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ── -->
  <section id="how" class="section-border">
    <div class="inner">

      <div class="reveal teal-rule">
        <span class="label label-accent">How Spensor Works</span>
      </div>

      <h2 class="reveal">An AI teammate that runs the work behind every event.</h2>

      <div class="steps-grid">

        <div class="reveal step-card">
          <div class="step-num">01 / INGEST</div>
          <h3>Brief it once.</h3>
          <p>
            Upload your exhibitor toolkit or submit through an intake form. Spensor parses every deadline, vendor, and milestone — and routes the work to the right people on your team.
          </p>
          <div class="step-card-footer">
            <span class="label">Event input → structured plan</span>
          </div>
        </div>

        <div class="reveal step-card" style="transition-delay:80ms">
          <div class="step-num">02 / ORCHESTRATE</div>
          <h3>Watch it coordinate.</h3>
          <p>
            Spensor drafts the runbook, schedules outreach, flags dependencies, and surfaces blockers before they become fires. You stay focused on the decisions that matter.
          </p>
          <div class="step-card-footer">
            <span class="label">Tasks → timelines → owner assignments</span>
          </div>
        </div>

        <div class="reveal step-card" style="transition-delay:160ms">
          <div class="step-num">03 / CLOSE THE LOOP</div>
          <h3>Report without rebuilding.</h3>
          <p>
            After every event, Spensor compiles attendance, spend, and pipeline attribution into a shareable summary. No manual pivot tables. No chasing AEs for feedback.
          </p>
          <div class="step-card-footer">
            <span class="label">Event data → executive summary</span>
          </div>
        </div>

        <div class="reveal step-card" style="transition-delay:240ms">
          <div class="step-num">04 / YOU STAY IN CONTROL</div>
          <h3>Approve, then ship.</h3>
          <p>
            Every action Spensor takes runs by you first. You see the proposal, you approve or adjust, then it executes. No autonomous moves on your accounts.
          </p>
          <div class="step-card-footer">
            <span class="label">Proposal → approval → execution</span>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ── CTA ── -->
  <section id="cta">
    <div class="glow"></div>
    <div class="inner">
      <div class="cta-content">

        <div class="reveal teal-rule">
          <span class="label label-accent">Get Started</span>
        </div>

        <h2 class="reveal">You run the events. We'll handle the rest.</h2>

        <p class="reveal cta-sub">
          We're onboarding 20 design partners to shape Spensor's first release. If you run 10+ events a year, you're who we built this for.
        </p>

        <div class="reveal trust" style="margin-bottom: 2.5rem;">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L8.5 5.5H13L9.5 8.5L11 13L7 10.5L3 13L4.5 8.5L1 5.5H5.5L7 1Z" stroke="#4338CA" stroke-width="1.2" stroke-linejoin="round"/></svg>
          <span class="label">20 spots · No commitment · Design partners only</span>
        </div>

        <form class="reveal access-form" id="access-form" action="https://formspree.io/f/xykojjrk" method="POST">
          <div>
            <label for="af-name">Name</label>
            <input id="af-name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" />
          </div>
          <div>
            <label for="af-email">Work email</label>
            <input id="af-email" name="email" type="email" required autocomplete="email" placeholder="jane@company.com" />
          </div>
          <div>
            <label for="af-company">Company</label>
            <input id="af-company" name="company" type="text" autocomplete="organization" placeholder="Acme Inc." />
          </div>
          <div>
            <label for="af-events">Events per year</label>
            <select id="af-events" name="events_per_year">
              <option value="">Select…</option>
              <option value="<10">Under 10</option>
              <option value="10-20">10–20</option>
              <option value="20-50">20–50</option>
              <option value="50+">50+</option>
            </select>
          </div>
          <div class="full">
            <label for="af-notes">What's the most painful part of your event ops? <span style="text-transform:none;letter-spacing:0;color:#5A5853;">(optional)</span></label>
            <textarea id="af-notes" name="notes" placeholder="Tell us a bit about your setup…"></textarea>
          </div>
          <input type="hidden" name="_subject" value="New Spensor design partner request" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" />
          <div class="form-actions">
            <button type="submit" class="btn-primary">Reserve a spot →</button>
            <span class="form-status" id="af-status" aria-live="polite"></span>
          </div>
        </form>

      </div>
    </div>
  </section>


  <!-- ── FOOTER ── -->
  <footer>
    <div class="inner">
      <span class="label">Spensor AI © 2026</span>
    </div>
  </footer>


  <!-- ── JS ── -->
  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 30);
    }, { passive: true });

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    document.querySelectorAll('#hero .reveal').forEach((el, i) => {
      setTimeout(() => el.classList.add('visible'), 100 + i * 120);
    });

    // ── Metrics animations ─────────────────────────────────
    (function() {
      // Build deadline grid (5 rows x 14 cols = 70 cells)
      const dg = document.getElementById('deadline-grid');
      if (dg) {
        const total = 5 * 14;
        const frag = document.createDocumentFragment();
        for (let i = 0; i < total; i++) {
          const c = document.createElement('div');
          c.className = 'cell';
          frag.appendChild(c);
        }
        dg.appendChild(frag);
      }

      // Build hours bars (12 weeks)
      const hb = document.getElementById('hours-bars');
      if (hb) {
        // before/after pattern: shorter = pre-Spensor, taller = current
        const heights = [0.18, 0.24, 0.20, 0.28, 0.22, 0.30, 0.62, 0.72, 0.80, 0.86, 0.92, 0.98];
        heights.forEach((h, i) => {
          const b = document.createElement('div');
          let cls = 'bar';
          if (i >= 6) cls += ' accent';
          if (i === heights.length - 1) cls += ' latest';
          b.className = cls;
          b.style.setProperty('--h', h);
          b.style.transitionDelay = (i * 60) + 'ms';
          hb.appendChild(b);
        });
      }

      // Counter animation
      function animateCounter(el) {
        const from = parseFloat(el.dataset.from || '0');
        const to = parseFloat(el.dataset.to || '0');
        const suffix = el.dataset.suffix || '';
        const dur = 1400;
        const start = performance.now();
        function tick(now) {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const v = from + (to - from) * eased;
          el.textContent = (to >= 100 ? Math.round(v).toLocaleString() : Math.round(v)) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      // Deadline grid fill — staggered random pattern
      function fillDeadlineGrid(card) {
        const cells = card.querySelectorAll('.deadline-grid .cell');
        const arr = Array.from(cells);
        // 98% done — pick a few warns and one miss
        const indices = arr.map((_, i) => i).sort(() => Math.random() - 0.5);
        const missIdx = indices.slice(0, 1);
        const warnIdx = indices.slice(1, 3);
        arr.forEach((c, i) => {
          setTimeout(() => {
            if (missIdx.includes(i)) c.classList.add('miss');
            else if (warnIdx.includes(i)) c.classList.add('warn');
            else c.classList.add('done');
          }, i * 18);
        });
      }

      const metricObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const card = entry.target;
          card.classList.add('in-view');
          card.querySelectorAll('[data-counter]').forEach(animateCounter);
          if (card.dataset.metric === 'deadlines') fillDeadlineGrid(card);
          metricObserver.unobserve(card);
        });
      }, { threshold: 0.15 });

      document.querySelectorAll('.metric-card').forEach(c => metricObserver.observe(c));
    })();
  </script>

  <!-- ── Hero canvas animation ── -->
  <script>
  (function() {
    const canvas = document.getElementById('hero-canvas');
    const ctx = canvas.getContext('2d');
    let W, H, nodes, packets, animId, mouseX = 0, mouseY = 0, mouseActive = false, t0 = performance.now();

    const ACCENT = { r: 67, g: 56, b: 202 };
    const ACCENT2 = { r: 129, g: 140, b: 248 };
    const NODE_COUNT = 56;
    const MAX_DIST = 200;
    const PACKET_RATE = 0.012; // chance per frame to spawn a packet on an active edge

    function resize() {
      const section = document.getElementById('hero');
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = section.offsetWidth;
      H = section.offsetHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function randRange(a, b) { return a + Math.random() * (b - a); }

    function initNodes() {
      nodes = Array.from({ length: NODE_COUNT }, () => {
        const depth = randRange(0.3, 1); // parallax depth
        return {
          x:  randRange(0, W),
          y:  randRange(0, H),
          vx: randRange(-0.25, 0.25) * depth,
          vy: randRange(-0.18, 0.18) * depth,
          r:  randRange(0.6, 1.8) * depth,
          depth,
          pulse: randRange(0, Math.PI * 2),
          pulseSpeed: randRange(0.008, 0.025),
          phase: randRange(0, Math.PI * 2),
        };
      });
      packets = [];
    }

    function spawnPacket(a, b) {
      packets.push({ a, b, t: 0, speed: randRange(0.012, 0.022) });
    }

    canvas.parentElement.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      mouseActive = true;
    });
    canvas.parentElement.addEventListener('mouseleave', () => { mouseActive = false; });

    function draw(now) {
      const time = (now - t0) / 1000;
      ctx.clearRect(0, 0, W, H);

      // Update positions with subtle flow-field perturbation
      nodes.forEach(n => {
        const flowX = Math.sin(n.y * 0.003 + time * 0.18 + n.phase) * 0.08;
        const flowY = Math.cos(n.x * 0.003 + time * 0.22 + n.phase) * 0.06;
        n.x += n.vx + flowX;
        n.y += n.vy + flowY;
        n.pulse += n.pulseSpeed;

        // Mouse repulsion
        if (mouseActive) {
          const dx = n.x - mouseX, dy = n.y - mouseY;
          const d2 = dx*dx + dy*dy;
          if (d2 < 28000) {
            const f = (1 - d2 / 28000) * 1.6;
            const d = Math.sqrt(d2) || 1;
            n.x += (dx / d) * f;
            n.y += (dy / d) * f;
          }
        }

        if (n.x < -60) n.x = W + 60;
        if (n.x > W + 60) n.x = -60;
        if (n.y < -60) n.y = H + 60;
        if (n.y > H + 60) n.y = -60;
      });

      // Draw edges + occasionally spawn packets
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < MAX_DIST) {
            const t = 1 - dist / MAX_DIST;
            const alpha = t * 0.22;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(${ACCENT.r},${ACCENT.g},${ACCENT.b},${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();

            // Spawn a packet occasionally on close, strong edges
            if (t > 0.6 && Math.random() < PACKET_RATE * 0.05) {
              spawnPacket(a, b);
            }
          }
        }
      }

      // Update + draw packets
      for (let i = packets.length - 1; i >= 0; i--) {
        const p = packets[i];
        p.t += p.speed;
        if (p.t >= 1) { packets.splice(i, 1); continue; }
        const x = p.a.x + (p.b.x - p.a.x) * p.t;
        const y = p.a.y + (p.b.y - p.a.y) * p.t;
        const fade = Math.sin(p.t * Math.PI);
        // trail
        const tx = p.a.x + (p.b.x - p.a.x) * Math.max(0, p.t - 0.18);
        const ty = p.a.y + (p.b.y - p.a.y) * Math.max(0, p.t - 0.18);
        const grd = ctx.createLinearGradient(tx, ty, x, y);
        grd.addColorStop(0, `rgba(${ACCENT2.r},${ACCENT2.g},${ACCENT2.b},0)`);
        grd.addColorStop(1, `rgba(${ACCENT2.r},${ACCENT2.g},${ACCENT2.b},${0.9 * fade})`);
        ctx.strokeStyle = grd;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(x, y);
        ctx.stroke();
        // head
        ctx.beginPath();
        ctx.arc(x, y, 1.8 * fade + 0.6, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ACCENT2.r},${ACCENT2.g},${ACCENT2.b},${fade})`;
        ctx.fill();
      }

      // Draw nodes
      nodes.forEach(n => {
        const pulse = 0.5 + 0.5 * Math.sin(n.pulse);
        const alpha = (0.25 + 0.5 * pulse) * (0.5 + n.depth * 0.5);
        const r = n.r + 0.7 * pulse;

        const grad = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 6);
        grad.addColorStop(0, `rgba(${ACCENT.r},${ACCENT.g},${ACCENT.b},${alpha * 0.45})`);
        grad.addColorStop(1, `rgba(${ACCENT.r},${ACCENT.g},${ACCENT.b},0)`);
        ctx.beginPath();
        ctx.arc(n.x, n.y, r * 6, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ACCENT.r},${ACCENT.g},${ACCENT.b},${alpha * 2})`;
        ctx.fill();
      });

      animId = requestAnimationFrame(draw);
    }

    function start() {
      if (animId) cancelAnimationFrame(animId);
      resize();
      initNodes();
      draw(performance.now());
    }

    window.addEventListener('resize', () => { resize(); initNodes(); }, { passive: true });
    if (document.readyState === 'complete') {
      start();
    } else {
      window.addEventListener('load', start);
    }
  })();
  </script>

  <!-- Access form submission (Formspree, AJAX) -->
  <script>
    (function() {
      const form = document.getElementById('access-form');
      if (!form) return;
      const status = document.getElementById('af-status');
      const submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.textContent = 'Sending…';
        status.className = 'form-status';
        submitBtn.disabled = true;

        try {
          const data = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' },
          });

          if (res.ok) {
            const success = document.createElement('div');
            success.className = 'access-form-success';
            success.innerHTML = '<strong>Got it.</strong> We\u2019ll be in touch within a few days about a design-partner slot.';
            form.replaceWith(success);
          } else {
            const json = await res.json().catch(() => ({}));
            const msg = (json.errors && json.errors[0] && json.errors[0].message) || 'Something went wrong. Please try again.';
            status.textContent = msg;
            status.className = 'form-status error';
            submitBtn.disabled = false;
          }
        } catch (err) {
          status.textContent = 'Network error. Please try again.';
          status.className = 'form-status error';
          submitBtn.disabled = false;
        }
      });
    })();
  </script>

  <!-- Tweaks panel -->
  <script type="text/babel" src="tweaks-panel.jsx"></script>
  <div id="tweaks-root"></div>

  <script type="text/babel">
    const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
      "accent": "#4338CA",
      "bgColor": "#0A0A0A",
      "buttonShape": "sharp",
      "headingWeight": "semibold",
      "showGlow": true
    }/*EDITMODE-END*/;

    const ACCENT_OPTIONS = [
      { label: "Deep Teal",  value: "#0F6E56" },
      { label: "Indigo",     value: "#4338CA" },
      { label: "Slate Blue", value: "#3B5BDB" },
      { label: "Warm Amber", value: "#B45309" },
      { label: "Dusty Rose", value: "#9D3F6A" },
      { label: "Custom",     value: "__custom__" },
    ];

    function lighten(hex, amount = 0.15) {
      const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
      const mix = c => Math.min(255, Math.round(c + (255 - c) * amount));
      return `rgb(${mix(r)},${mix(g)},${mix(b)})`;
    }

    function applyTweaks({ accent, bgColor, buttonShape, headingWeight, showGlow }) {
      const bg = bgColor || '#0A0A0A';
      document.body.style.backgroundColor = bg;

      const rr = parseInt(bg.slice(1,3),16), gg = parseInt(bg.slice(3,5),16), bb = parseInt(bg.slice(5,7),16);
      const lift = c => Math.min(255, c + 10);
      document.querySelectorAll('.step-card').forEach(el => {
        el.style.backgroundColor = `rgb(${lift(rr)},${lift(gg)},${lift(bb)})`;
      });

      const navEl = document.getElementById('nav');
      if (navEl) navEl.style.setProperty('--nav-bg', `rgba(${rr},${gg},${bb},0.88)`);

      const accentHover = lighten(accent);
      const accentGlow  = accent + '73';
      document.querySelectorAll('.btn-primary').forEach(el => { el.style.backgroundColor = accent; });

      let styleEl = document.getElementById('tweak-overrides');
      if (!styleEl) { styleEl = document.createElement('style'); styleEl.id = 'tweak-overrides'; document.head.appendChild(styleEl); }

      const radius = buttonShape === 'rounded' ? '9999px' : buttonShape === 'soft' ? '6px' : '2px';
      const weight = headingWeight === 'bold' ? '700' : headingWeight === 'light' ? '300' : '600';

      styleEl.textContent = `
        .btn-primary { background-color: ${accent} !important; border-radius: ${radius} !important; }
        .btn-primary:hover { background-color: ${accentHover} !important; box-shadow: 0 0 22px 0 ${accentGlow} !important; }
        .btn-secondary { border-radius: ${radius} !important; }
        .btn-secondary:hover { color: ${accentHover} !important; border-color: ${accent} !important; }
        .step-card:hover { border-color: ${accent} !important; }
        .teal-rule::before { background: ${accent} !important; }
        .label-accent { color: ${accent} !important; }
        .step-num { color: ${accent} !important; }
        footer a:hover { color: ${accent} !important; }
        .gradient-text {
          background: linear-gradient(135deg, #F2F0EB 40%, ${accent} 100%) !important;
          -webkit-background-clip: text !important; background-clip: text !important;
          -webkit-text-fill-color: transparent !important;
        }
        h1, h2, h3 { font-weight: ${weight} !important; }
        ${showGlow ? '' : 'body::before { opacity: 0 !important; } .glow { opacity: 0 !important; }'}
      `;
    }

    function SpensorTweaks() {
      const [tweaks, setTweak] = useTweaks(TWEAK_DEFAULTS);
      const [customAccent, setCustomAccent] = React.useState('');
      const effectiveAccent = tweaks.accent === '__custom__' ? (customAccent || '#4338CA') : tweaks.accent;

      React.useEffect(() => {
        applyTweaks({ ...tweaks, accent: effectiveAccent });
      }, [tweaks, effectiveAccent]);

      return React.createElement(TweaksPanel, { title: "Tweaks" },
        React.createElement(TweakSection, { title: "Background" },
          React.createElement(TweakRadio, {
            label: "Color", value: tweaks.bgColor,
            options: [
              { label: "Near Black", value: "#0A0A0A" },
              { label: "Dark Gray",  value: "#1A1A1A" },
              { label: "Charcoal",   value: "#212121" },
            ],
            onChange: v => setTweak('bgColor', v),
          })
        ),
        React.createElement(TweakSection, { title: "Accent Color" },
          React.createElement(TweakSelect, {
            label: "Palette", value: tweaks.accent,
            options: ACCENT_OPTIONS.map(o => ({ label: o.label, value: o.value })),
            onChange: v => setTweak('accent', v),
          }),
          tweaks.accent === '__custom__' && React.createElement(TweakColor, {
            label: "Custom color", value: customAccent || '#4338CA',
            onChange: v => setCustomAccent(v),
          }),
          React.createElement('div', { style: { marginTop: 8, height: 28, borderRadius: 4, background: effectiveAccent, transition: 'background 200ms' } })
        ),
        React.createElement(TweakSection, { title: "Buttons" },
          React.createElement(TweakRadio, {
            label: "Shape", value: tweaks.buttonShape,
            options: [{ label: "Sharp", value: "sharp" }, { label: "Soft", value: "soft" }, { label: "Pill", value: "rounded" }],
            onChange: v => setTweak('buttonShape', v),
          })
        ),
        React.createElement(TweakSection, { title: "Typography" },
          React.createElement(TweakRadio, {
            label: "Heading weight", value: tweaks.headingWeight,
            options: [{ label: "Light", value: "light" }, { label: "Medium", value: "semibold" }, { label: "Bold", value: "bold" }],
            onChange: v => setTweak('headingWeight', v),
          })
        ),
        React.createElement(TweakSection, { title: "Effects" },
          React.createElement(TweakToggle, {
            label: "Glow & grain", value: tweaks.showGlow,
            onChange: v => setTweak('showGlow', v),
          })
        )
      );
    }

    ReactDOM.createRoot(document.getElementById('tweaks-root')).render(React.createElement(SpensorTweaks));
  </script>

</body>
</html>
